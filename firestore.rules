
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        request.auth.token.admin == true;
    }

    function validString(value, maxLength) {
      return value is string &&
        value.size() <= maxLength;
    }

    // --------------------------------------------------
    // STUDENT PROFILES
    // --------------------------------------------------

    match /users/{uid} {

      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'student' &&
        request.resource.data.accountStatus == 'pending' &&
        request.resource.data.subscriptionStatus == 'inactive' &&
        request.resource.data.accessEnabled == false;

      allow read: if isOwner(uid) || isAdmin();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // ACADEMIC YEARS
    // --------------------------------------------------

    match /academic_years/{yearId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // --------------------------------------------------
    // SUBJECTS
    // --------------------------------------------------

    match /academic_subjects/{subjectId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // --------------------------------------------------
    // TOPICS
    // --------------------------------------------------

    match /academic_topics/{topicId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // --------------------------------------------------
    // LEARNING RESOURCES
    // --------------------------------------------------

    match /learning_resources/{resourceId} {
      allow read: if signedIn() &&
        (
          isAdmin() ||
          resourcePublished()
        );

      allow create, update, delete: if isAdmin();

      function resourcePublished() {
        return resource.data.isPublished == true;
      }
    }

    // --------------------------------------------------
    // SUBSCRIPTION PLANS
    // --------------------------------------------------

    match /subscription_plans/{planId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // --------------------------------------------------
    // SUBSCRIPTION REQUESTS
    // --------------------------------------------------

    match /subscription_requests/{requestId} {

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reviewedBy == null &&
        request.resource.data.reviewedAt == null;

      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );

      allow update, delete: if isAdmin();
    }

    // --------------------------------------------------
    // MCQ QUESTION BANK
    // --------------------------------------------------

    match /mcqs/{mcqId} {

      // Students can only read published questions.
      // Administrators can read the complete bank.
      allow read: if isAdmin() ||
        (
          signedIn() &&
          resource.data.isPublished == true
        );

      // Only administrators can manage questions.
      allow create, update, delete: if isAdmin();
    }

    // --------------------------------------------------
    // MCQ PRACTICE ATTEMPTS
    // --------------------------------------------------

    match /mcq_attempts/{attemptId} {

      // Students can save their own practice results.
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type == 'practice' &&
        request.resource.data.totalQuestions is int &&
        request.resource.data.totalQuestions > 0 &&
        request.resource.data.correctAnswers is int &&
        request.resource.data.correctAnswers >= 0 &&
        request.resource.data.correctAnswers <=
          request.resource.data.totalQuestions &&
        request.resource.data.questionIds is list &&
        request.resource.data.questionIds.size() ==
          request.resource.data.totalQuestions;

      // Only the owner or an administrator can read.
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );

      // Completed attempts cannot be modified by students.
      allow update, delete: if isAdmin();
    }

    // --------------------------------------------------
    // NOTIFICATIONS
    // --------------------------------------------------

    match /notifications/{notificationId} {
      allow read: if isAdmin() ||
        (
          signedIn() &&
          resource.data.userId == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }

    // --------------------------------------------------
    // EXAM COLLECTIONS
    // --------------------------------------------------

    match /exams/{examId} {
      allow read: if isAdmin() ||
        (
          signedIn() &&
          resource.data.isPublished == true
        );

      allow create, update, delete: if isAdmin();
    }

    match /exam_attempts/{attemptId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );

      allow update, delete: if isAdmin();
    }

    // --------------------------------------------------
    // DEFAULT DENY
    // --------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
