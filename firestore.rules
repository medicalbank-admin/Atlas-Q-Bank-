rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================================================
    // AUTHENTICATION AND COMMON HELPERS
    // ==================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        request.auth.token.admin == true;
    }

    function validString(value, maxLength) {
      return value is string &&
        value.size() > 0 &&
        value.size() <= maxLength;
    }

    function validOptionalImage(value, maxLength) {
      return value == null ||
        validString(value, maxLength);
    }

    function hasActiveAccess() {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.accessEnabled == true &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.subscriptionStatus == 'active';
    }

    function hasFeatureAccess(feature) {
      return hasActiveAccess() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.subscriptionExpiryAt > request.time &&
        (
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.subscriptionAccessPermissions[feature] == true ||
          (
            feature == 'mistakesNotebook' &&
            !get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.subscriptionAccessPermissions.keys().hasAny(['mistakesNotebook']) &&
            (
              get(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.subscriptionAccessPermissions['mcqPractice'] == true ||
              get(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.subscriptionAccessPermissions['examinations'] == true
            )
          )
        );
    }

    function validSubscriptionPlan(planId) {
      return exists(
        /databases/$(database)/documents/subscription_plans/$(planId)
      ) &&
      get(
        /databases/$(database)/documents/subscription_plans/$(planId)
      ).data.isActive == true;
    }

    // ==================================================
    // STUDENT PROFILES
    // ==================================================

    match /users/{uid} {
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasAll([
          'uid',
          'fullName',
          'fatherName',
          'nationalId',
          'whatsappNumber',
          'email',
          'countryOfStudy',
          'university',
          'profileImageUrl',
          'profileImagePath',
          'role',
          'accountStatus',
          'subscriptionStatus',
          'accessEnabled',
          'emailVerified',
          'termsAccepted',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'fatherName',
          'nationalId',
          'whatsappNumber',
          'email',
          'countryOfStudy',
          'university',
          'profileImageUrl',
          'profileImagePath',
          'role',
          'accountStatus',
          'subscriptionStatus',
          'accessEnabled',
          'emailVerified',
          'termsAccepted',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.uid == uid &&
        validString(request.resource.data.fullName, 120) &&
        validString(request.resource.data.fatherName, 120) &&
        validString(request.resource.data.nationalId, 50) &&
        validString(request.resource.data.whatsappNumber, 30) &&
        validString(request.resource.data.email, 254) &&
        request.resource.data.email == request.auth.token.email &&
        validString(request.resource.data.countryOfStudy, 100) &&
        validString(request.resource.data.university, 200) &&
        validOptionalImage(request.resource.data.profileImageUrl, 2048) &&
        validOptionalImage(request.resource.data.profileImagePath, 500) &&
        request.resource.data.role == 'student' &&
        request.resource.data.accountStatus == 'approved' &&
        request.resource.data.subscriptionStatus == 'inactive' &&
        request.resource.data.accessEnabled == false &&
        request.resource.data.emailVerified == false &&
        request.resource.data.termsAccepted == true &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;

      allow read: if isOwner(uid) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['whatsappNumber', 'updatedAt']) &&
        validString(request.resource.data.whatsappNumber, 30)
      ) || (
        isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'emailVerified', 'updatedAt']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.emailVerified == request.auth.token.email_verified
      );
      allow delete: if isAdmin();
    }

    // ==================================================
    // ACADEMIC YEARS
    // ==================================================

    match /academic_years/{yearId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ==================================================
    // ACADEMIC SUBJECTS
    // ==================================================

    match /academic_subjects/{subjectId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ==================================================
    // ACADEMIC TOPICS
    // ==================================================

    match /academic_topics/{topicId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ==================================================
    // EXAM CATEGORY METADATA
    // ==================================================
    match /exam_categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /mcq_exam_sets/{examSetId} {
      // Structured academy exams and past papers are the only student exam tracks.
      allow read: if isAdmin() || (
        resource.data.isPublished == true &&
        (
          (resource.data.trackType == 'structured' &&
            (hasFeatureAccess('examinations') || hasFeatureAccess('mcqPractice'))) ||
          (resource.data.trackType == 'past_paper' &&
            (hasFeatureAccess('pastPapers') ||
              hasFeatureAccess('examinations')))
        )
      );
      allow create, update, delete: if isAdmin();
    }

    // ==================================================
    // LEARNING RESOURCES
    // ==================================================

    match /learning_resources/{resourceId} {
      allow read: if isAdmin() ||
        (
          hasFeatureAccess('studyLibrary') &&
          resource.data.isPublished == true
        );

      allow create, update, delete: if isAdmin();
    }

    // ==================================================
    // ==================================================
    // CLINICAL CASE-BASED LEARNING
    // ==================================================
    match /clinical_cases/{caseId} {
      allow read: if isAdmin() || (
        resource.data.isPublished == true &&
        hasFeatureAccess('clinicalCases')
      );
      allow create, update, delete: if isAdmin();
    }

    match /clinical_case_attempts/{attemptId} {
      allow create: if signedIn() &&
        hasFeatureAccess('clinicalCases') &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.caseId is string &&
        request.resource.data.totalQuestions is int &&
        request.resource.data.correctAnswers is int &&
        request.resource.data.percentage is number &&
        request.resource.data.answers is list;
      allow read: if isAdmin() || (
        signedIn() &&
        resource.data.userId == request.auth.uid &&
        hasFeatureAccess('clinicalCases')
      );
      allow update, delete: if false;
    }

    // ==================================================
    // STUDENT MISTAKES NOTEBOOK
    // ==================================================
    match /mistake_notebook/{mistakeId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      ) && (isAdmin() || hasFeatureAccess('mistakesNotebook'));
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        hasFeatureAccess('mistakesNotebook') &&
        request.resource.data.question is string &&
        request.resource.data.question.size() <= 5000;
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        hasFeatureAccess('mistakesNotebook') &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['personalNote','isReviewed','reviewedAt']);
      allow delete: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        hasFeatureAccess('mistakesNotebook');
    }

    // ==================================================
    // STUDENT DISCUSSION FORUM
    // ==================================================
    match /forum_posts/{postId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.status == 'published' ||
          resource.data.userId == request.auth.uid
        ) && hasFeatureAccess('discussionForum')
      );
      allow create: if signedIn() &&
        hasFeatureAccess('discussionForum') &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 180 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 8000 &&
        request.resource.data.status == 'published';
      allow update, delete: if isAdmin();
      match /replies/{replyId} {
        allow read: if isAdmin() || (
          signedIn() &&
          get(/databases/$(database)/documents/forum_posts/$(postId)).data.status == 'published' &&
          hasFeatureAccess('discussionForum')
        );
        allow create: if signedIn() &&
          hasFeatureAccess('discussionForum') &&
          get(/databases/$(database)/documents/forum_posts/$(postId)).data.status == 'published' &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 4000;
        allow update, delete: if isAdmin();
      }
    }

    // ==================================================
    // ASK A TEACHER / DOUBT RESOLUTION
    // ==================================================
    match /teacher_questions/{questionId} {
      allow create: if signedIn() &&
        hasFeatureAccess('askTeacher') &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.subject is string &&
        request.resource.data.question is string &&
        request.resource.data.question.size() > 0 &&
        request.resource.data.question.size() <= 8000 &&
        request.resource.data.status == 'open';
      allow read: if isAdmin() || (
        signedIn() &&
        resource.data.userId == request.auth.uid &&
        hasFeatureAccess('askTeacher')
      );
      allow update, delete: if isAdmin();
    }

    // ==================================================
    // FCM DEVICE REGISTRATIONS
    // ==================================================
    match /user_device_tokens/{tokenId} {
      allow create, update: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.token is string &&
        request.resource.data.token.size() <= 4096;
      allow read: if isAdmin();
      allow delete: if isAdmin() || (
        signedIn() && resource.data.userId == request.auth.uid
      );
    }

    // SUBSCRIPTION PLANS
    // ==================================================

    match /subscription_plans/{planId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ==================================================
    // ACADEMY PAYMENT SETTINGS
    // Students may read payment instructions; only admins may edit them.
    // ==================================================

    match /academy_settings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ==================================================
    // SUBSCRIPTION REQUESTS
    // ==================================================

    match /subscription_requests/{requestId} {
      allow create: if signedIn() &&
        request.auth.token.email_verified == true &&
        request.resource.data.keys().hasAll([
          'studentUid',
          'studentName',
          'studentEmail',
          'planId',
          'planName',
          'durationDays',
          'amount',
          'currency',
          'paymentMethod',
          'transactionReference',
          'proofImageUrl',
          'proofImagePath',
          'status',
          'adminNote',
          'reviewedBy',
          'createdAt',
          'reviewedAt'
        ]) &&
        request.resource.data.studentUid == request.auth.uid &&
        validString(request.resource.data.studentName, 120) &&
        request.resource.data.studentEmail == request.auth.token.email &&
        validString(request.resource.data.planId, 150) &&
        validString(request.resource.data.planName, 150) &&
        validSubscriptionPlan(request.resource.data.planId) &&
        request.resource.data.durationDays ==
          get(
            /databases/$(database)/documents/subscription_plans/$(request.resource.data.planId)
          ).data.durationDays &&
        request.resource.data.amount is number &&
        request.resource.data.amount ==
          get(
            /databases/$(database)/documents/subscription_plans/$(request.resource.data.planId)
          ).data.price &&
        request.resource.data.currency ==
          get(
            /databases/$(database)/documents/subscription_plans/$(request.resource.data.planId)
          ).data.currency &&
        request.resource.data.durationDays > 0 &&
        validString(request.resource.data.currency, 10) &&
        validString(request.resource.data.paymentMethod, 80) &&
        validString(request.resource.data.transactionReference, 200) &&
        request.resource.data.proofImageUrl == null &&
        request.resource.data.proofImagePath == null &&
        request.resource.data.status == 'pending' &&
        request.resource.data.adminNote == null &&
        request.resource.data.reviewedBy == null &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.reviewedAt == null;

      allow read: if signedIn() &&
        (
          resource.data.studentUid == request.auth.uid ||
          isAdmin()
        );

      // Only a verified administrator may review a pending request.
      // Students cannot edit or approve their own payment requests.
      allow update: if isAdmin() &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'adminNote', 'reviewedBy', 'reviewedAt', 'updatedAt']) &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.adminNote is string;
      allow delete: if false;
    }

    // ==================================================
    // STUDENT LEARNING RESOURCE PROGRESS
    // Students may create and update only their own completion records.
    // ==================================================
    match /student_resource_progress/{progressId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.resourceId is string &&
        request.resource.data.completed is bool;
      // On updates, the existing record must already belong to this student.
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.resourceId is string &&
        request.resource.data.completed is bool;
      allow delete: if isAdmin();
    }

    // ==================================================
    // MCQ PUBLIC QUESTION DATA
    // ==================================================

    match /mcqs/{mcqId} {
      // Students can read published questions only.
      // Public documents must NOT contain answer keys
      // or explanations.

      allow read: if isAdmin() ||
        (
          resource.data.isPublished == true &&
          !resource.data.keys().hasAny(['correctAnswer', 'explanation']) &&
          (
            // Structured academy exam questions.
            (resource.data.trackType == 'structured' &&
              (hasFeatureAccess('mcqPractice') ||
                hasFeatureAccess('examinations'))) ||
            // Past-paper questions are restricted to the Past Papers entitlement.
            (resource.data.trackType == 'past_paper' &&
              (hasFeatureAccess('pastPapers') ||
                hasFeatureAccess('examinations')))
          )
        );

      allow create, update, delete: if isAdmin();
    }

    // ==================================================
    // MCQ PRIVATE ANSWER KEYS
    // ==================================================

    match /mcq_answer_keys/{mcqId} {
      // Only administrators can access answer keys.

      allow read, create, update, delete: if isAdmin();
    }

    // Server-owned timed MCQ sessions. Clients cannot read or modify them.
    match /mcq_practice_sessions/{sessionId} {
      allow read, write: if false;
    }

    // ==================================================
    // MCQ PRACTICE ATTEMPTS
    // ==================================================

    match /mcq_attempts/{attemptId} {
      // Only trusted backend code can create attempts.
      allow create: if false;

      // Students can read their own results.
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );

      // Students cannot modify scores or result snapshots.
      allow update, delete: if isAdmin();
    }

    // ==================================================
    // PUSH NOTIFICATION CAMPAIGNS
    // Campaign drafts, scheduled jobs and send history are admin-managed.
    // ==================================================
    match /push_notifications/{notificationId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /push_notification_events/{eventId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.notificationId is string &&
        request.resource.data.event == 'opened';
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ==================================================
    // NOTIFICATIONS
    // ==================================================

    match /notifications/{notificationId} {
      allow read: if isAdmin() ||
        (
          signedIn() &&
          (
            resource.data.userId == request.auth.uid ||
            (resource.data.audience == 'all' && resource.data.isActive == true)
          )
        );

      allow create, update, delete: if isAdmin();
    }

    // ==================================================
    // EXAMS
    // ==================================================

    match /exams/{examId} {
      allow read: if isAdmin() ||
        (
          hasFeatureAccess('examinations') &&
          resource.data.isPublished == true
        );

      allow create, update, delete: if isAdmin();
    }

    // ==================================================
    // EXAM ATTEMPTS
    // ==================================================

    match /exam_attempts/{attemptId} {
      allow create: if hasActiveAccess() &&
        request.resource.data.userId == request.auth.uid;

      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );

      allow update, delete: if isAdmin();
    }

    // ==================================================
    // 3D ANATOMY LAB
    // Published learning notes require the anatomyLab entitlement.
    // ==================================================
    match /anatomy_content/{structureKey} {
      allow read: if isAdmin() || (
        resource.data.isPublished == true &&
        hasFeatureAccess('anatomyLab')
      );
      allow create, update, delete: if isAdmin();
    }

    match /anatomy_progress/{progressId} {
      allow read: if isAdmin() || (
        signedIn() &&
        resource.data.userId == request.auth.uid &&
        hasFeatureAccess('anatomyLab')
      );
      allow create: if signedIn() &&
        hasFeatureAccess('anatomyLab') &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.structureKey is string;
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        hasFeatureAccess('anatomyLab') &&
        request.resource.data.structureKey == resource.data.structureKey;
      allow delete: if isAdmin();
    }

    // ==================================================
    // ATLAS CLINICAL LEARNING ATTEMPTS
    // Spotter, clinical-correlation and hardcoded MCQ scores are
    // student-owned summaries. Clients cannot edit submitted scores.
    // ==================================================
    match /advanced_learning_attempts/{attemptId} {
      function attemptFeatureAllowed(mode) {
        return (mode == 'clinical_case' &&
            hasFeatureAccess('clinicalCases')) ||
          (mode in ['3d_spotter', 'advanced_quiz'] &&
            hasFeatureAccess('mcqPractice'));
      }

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.mode in [
          '3d_spotter', 'clinical_case', 'advanced_quiz'
        ] &&
        attemptFeatureAllowed(request.resource.data.mode) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 180 &&
        request.resource.data.correctAnswers is int &&
        request.resource.data.totalQuestions is int &&
        request.resource.data.totalQuestions > 0 &&
        request.resource.data.correctAnswers >= 0 &&
        request.resource.data.correctAnswers <= request.resource.data.totalQuestions &&
        request.resource.data.percentage is number &&
        request.resource.data.percentage >= 0 &&
        request.resource.data.percentage <= 100 &&
        request.resource.data.completedAt is timestamp;

      allow read: if isAdmin() || (
        signedIn() &&
        resource.data.userId == request.auth.uid &&
        attemptFeatureAllowed(resource.data.mode)
      );
      allow update, delete: if false;
    }

    // ==================================================
    // STUDENT SMART FLASHCARD PROGRESS
    // Each authenticated student may read and write only their own
    // progress document. No student can access another student's data.
    // ==================================================
    match /user_flashcard_progress/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'userId', 'bookmarks', 'mastered', 'review', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'userId', 'bookmarks', 'mastered', 'review', 'updatedAt'
        ]) &&
        request.resource.data.bookmarks is list &&
        request.resource.data.bookmarks.size() <= 200 &&
        request.resource.data.mastered is list &&
        request.resource.data.mastered.size() <= 200 &&
        request.resource.data.review is list &&
        request.resource.data.review.size() <= 200 &&
        request.resource.data.updatedAt is timestamp;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ==================================================
    // PRIVATE STUDENT ↔ ADMINISTRATOR INBOX
    // Conversation document ID is the student UID.
    // ==================================================
    match /inbox_conversations/{studentUid} {
      function isConversationStudent() {
        return signedIn() && request.auth.uid == studentUid &&
          resource.data.studentUid == request.auth.uid;
      }

      allow read: if isAdmin() || (signedIn() && request.auth.uid == studentUid);

      allow create: if signedIn() &&
        (isAdmin() || (
          request.resource.data.studentUid == request.auth.uid &&
          request.resource.data.studentName ==
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName &&
          request.resource.data.studentEmail ==
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email
        )) &&
        request.resource.data.keys().hasAll([
          'studentUid', 'studentName', 'studentEmail', 'studentPhone',
          'studentUniversity', 'studentCountry', 'studentProfileImageUrl',
          'adminUid', 'adminName', 'lastMessage', 'lastMessageAt',
          'lastSenderUid', 'lastMessageId', 'unreadForStudent', 'unreadForAdmin',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.studentName is string &&
        request.resource.data.studentName.size() <= 120 &&
        request.resource.data.studentEmail is string &&
        request.resource.data.studentEmail.size() <= 254 &&
        request.resource.data.studentPhone is string &&
        request.resource.data.studentPhone.size() <= 30 &&
        request.resource.data.studentUniversity is string &&
        request.resource.data.studentUniversity.size() <= 200 &&
        request.resource.data.studentCountry is string &&
        request.resource.data.studentCountry.size() <= 100 &&
        request.resource.data.studentProfileImageUrl is string &&
        request.resource.data.studentProfileImageUrl.size() <= 2048 &&
        request.resource.data.adminName == 'The Atlas Administrator' &&
        (request.resource.data.adminUid == null ||
          (isAdmin() && request.resource.data.adminUid == request.auth.uid)) &&
        request.resource.data.lastMessage == '' &&
        request.resource.data.lastSenderUid == '' &&
        request.resource.data.lastMessageId == '' &&
        request.resource.data.unreadForStudent == 0 &&
        request.resource.data.unreadForAdmin == 0;

      allow update: if isAdmin() ||
        (isConversationStudent() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'lastMessageAt', 'lastSenderUid', 'lastMessageId',
            'unreadForAdmin', 'unreadForStudent', 'updatedAt'
          ]) &&
          (
            // A student message increments the administrator's unread count.
            (request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'lastMessageAt'
              ]) &&
              request.resource.data.lastMessage is string &&
              request.resource.data.lastMessage.size() <= 4000 &&
              request.resource.data.lastMessageAt is timestamp &&
              request.resource.data.lastSenderUid == request.auth.uid &&
              request.resource.data.lastMessageId is string &&
              request.resource.data.lastMessageId.size() > 0 &&
              request.resource.data.unreadForStudent == 0 &&
              request.resource.data.unreadForAdmin is int &&
              request.resource.data.unreadForAdmin ==
                (resource.data.unreadForAdmin is int
                  ? resource.data.unreadForAdmin + 1
                  : 1)) ||
            // Opening the thread clears only the student's unread counter.
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'unreadForStudent', 'updatedAt'
              ]) &&
              request.resource.data.unreadForStudent == 0)
          ));

      allow delete: if false;

      match /messages/{messageId} {
        function parentStudentUid() {
          return get(/databases/$(database)/documents/inbox_conversations/$(studentUid)).data.studentUid;
        }

        allow read: if isAdmin() ||
          (signedIn() && parentStudentUid() == request.auth.uid);

        allow create: if signedIn() &&
          (isAdmin() || parentStudentUid() == request.auth.uid) &&
          request.resource.data.keys().hasAll([
            'senderUid', 'senderRole', 'body', 'imageUrl',
            'imagePath', 'createdAt', 'deliveredAt', 'readAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'senderUid', 'senderRole', 'body', 'imageUrl',
            'imagePath', 'createdAt', 'deliveredAt', 'readAt'
          ]) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.senderRole == (isAdmin() ? 'admin' : 'student') &&
          request.resource.data.body is string &&
          request.resource.data.body.size() <= 4000 &&
          (request.resource.data.body.size() > 0 ||
            ((request.resource.data.imageUrl is string &&
              request.resource.data.imageUrl.size() > 0) ||
             (request.resource.data.imagePath is string &&
              request.resource.data.imagePath.size() > 0))) &&
          (request.resource.data.imageUrl == null ||
            (request.resource.data.imageUrl is string &&
             request.resource.data.imageUrl.size() <= 2048)) &&
          (request.resource.data.imagePath == null ||
            (request.resource.data.imagePath is string &&
             request.resource.data.imagePath.size() <= 500)) &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.deliveredAt == null &&
          request.resource.data.readAt == null;

        allow update: if isAdmin() ||
          (signedIn() &&
            parentStudentUid() == request.auth.uid &&
            resource.data.senderUid != request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'deliveredAt', 'readAt'
            ]) &&
            request.resource.data.deliveredAt is timestamp &&
            (request.resource.data.readAt == null ||
             request.resource.data.readAt is timestamp));

        allow delete: if false;
      }
    }

    // ==================================================
    // DEFAULT DENY
    // ==================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
