rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isSignedIn()
        && request.auth.uid == uid;
    }

    function isValidImage() {
      return request.resource != null
        && request.resource.contentType.matches(
          'image/(jpeg|jpg|png|webp)'
        )
        && request.resource.size < 10 * 1024 * 1024;
    }

    // -----------------------------------------
    // STUDENT PROFILE PICTURES
    // Path: student_profiles/{uid}/profile.jpg
    // -----------------------------------------

    match /student_profiles/{uid}/{fileName} {

      allow read: if isOwner(uid) || isAdmin();

      // Students can upload an image only to their own folder.
      allow create: if isOwner(uid)
        && fileName.matches('profile\\.(jpg|jpeg|png|webp)')
        && isValidImage();

      // Only administrators can replace or delete files.
      allow update, delete: if isAdmin();
    }

    // -----------------------------------------
    // SUBSCRIPTION PAYMENT PROOFS
    // Path: subscription_payment_proofs/{uid}/{file}
    // -----------------------------------------

    match /subscription_payment_proofs/{uid}/{fileName} {

      allow read: if isOwner(uid) || isAdmin();

      // Students can upload payment proof only to their own folder.
      allow create: if isOwner(uid)
        && fileName.matches(
          '[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)'
        )
        && isValidImage();

      // Uploaded payment proofs cannot be replaced or deleted
      // by students.
      allow update, delete: if isAdmin();
    }

    // -----------------------------------------
    // ADMIN LEARNING MATERIALS
    // PDFs and videos uploaded by administrators.
    // -----------------------------------------
    match /learning_resources/{yearId}/{subjectId}/{topicId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource != null
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches(
          '(application/pdf|video/mp4|video/quicktime|video/webm)'
        );
      allow delete: if isAdmin();
    }

    // -----------------------------------------
    // PRIVATE STUDENT ↔ ADMINISTRATOR INBOX IMAGES
    // Path: inbox_media/{studentUid}/{uploaderUid}/{file}
    // -----------------------------------------
    match /inbox_media/{studentUid}/{uploaderUid}/{fileName} {
      function conversationExists() {
        return firestore.exists(
          /databases/(default)/documents/inbox_conversations/$(studentUid)
        );
      }

      function conversationStudent() {
        return firestore.get(
          /databases/(default)/documents/inbox_conversations/$(studentUid)
        ).data.studentUid;
      }

      allow read: if isAdmin() ||
        (isSignedIn() && conversationExists() &&
         conversationStudent() == request.auth.uid);

      allow create: if isSignedIn() &&
        request.auth.uid == uploaderUid &&
        conversationExists() &&
        (isAdmin() || conversationStudent() == request.auth.uid) &&
        fileName.matches('[A-Za-z0-9._-]+') &&
        isValidImage() &&
        request.resource.size < 8 * 1024 * 1024;

      allow update, delete: if false;
    }

    // -----------------------------------------
    // PUBLIC ATLAS ACADEMY ANDROID APP RELEASES
    // Only administrators may upload or replace release APKs.
    // Each version is stored under its own immutable filename.
    // -----------------------------------------
    match /app_releases/android/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        fileName.matches('[0-9]+[.][0-9]+[.][0-9]+(-[0-9]+)?[.]apk') &&
        request.resource != null &&
        request.resource.contentType == 'application/vnd.android.package-archive' &&
        request.resource.size > 0 &&
        request.resource.size <= 262144000;
      allow delete: if isAdmin();
    }

    // -----------------------------------------
    // DEFAULT DENY
    // -----------------------------------------

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
